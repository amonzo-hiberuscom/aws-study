  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "padding": 12
  },
  "sequence": {
    "diagramMarginX": 15,
    "diagramMarginY": 10,
    "actorMargin": 45,
    "width": 140,
    "height": 40,
    "boxMargin": 8,
    "boxTextMargin": 5,
    "noteMargin": 10,
    "messageMargin": 30,
    "mirrorActors": true,
    "useMaxWidth": false
  }
}