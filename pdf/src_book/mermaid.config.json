{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Liberation Sans, DejaVu Sans, Arial, sans-serif",
    "fontSize": "13px",
    "primaryColor": "#eef4fa",
    "primaryBorderColor": "#16344f",
    "primaryTextColor": "#10233f",
    "secondaryColor": "#fef8ee",
    "secondaryBorderColor": "#c98a1d",
    "secondaryTextColor": "#5a3e08",
    "tertiaryColor": "#f4f7fb",
    "tertiaryBorderColor": "#8a94a3",
    "tertiaryTextColor": "#1c2530",
    "lineColor": "#16344f",
    "actorBkg": "#eef4fa",
    "actorBorder": "#16344f",
    "actorTextColor": "#10233f",
    "actorLineColor": "#8a94a3",
    "signalColor": "#16344f",
    "signalTextColor": "#10233f",
    "labelBoxBkgColor": "#eef4fa",
    "labelBoxBorderColor": "#16344f",
    "labelTextColor": "#10233f",
    "loopTextColor": "#10233f",
    "noteBorderColor": "#d6dfe8",
    "noteBkgColor": "#fff9e6",
    "noteTextColor": "#333333",
    "activationBorderColor": "#16344f",
    "activationBkgColor": "#dce8f5",
    "sequenceNumberColor": "#ffffff",
    "subGraphBkgColor": "#f8fafc",
    "subGraphBorderColor": "#b9cbdb",
    "mainBkg": "#eef4fa",
    "nodeBorder": "#16344f"
